# ============================================================================
#  API environment — DEVELOPMENT template
#  Copy to .env and fill in. NEVER commit a real .env. Values here are
#  placeholders only. Validation source of truth: apps/api/src/config/config.schema.ts
# ============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Comma-separated allowed CORS origins (web + Expo dev).
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# ─── Multi-tenancy (Phase 12) ────────────────────────────────────────────────
# Base platform domain — tenant subdomains: <slug>.PLATFORM_DOMAIN
# In production: yourdomain.in  →  mybrand.yourdomain.in
# In dev: set to localhost or leave blank (subdomain routing disabled locally)
PLATFORM_DOMAIN=yourdomain.in
# Web: same value exposed to Next.js — used by middleware to parse subdomains
NEXT_PUBLIC_ROOT_DOMAIN=yourdomain.in

# ─── Database (Postgres) ─────────────────────────────────────────────────────
# Pooled URL for app queries; DIRECT_URL (unpooled) for Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# ─── Redis ───────────────────────────────────────────────────────────────────
# Optional in dev (falls back to in-memory). Required in staging/production.
REDIS_URL=redis://localhost:6379

# ─── JWT (RS256) ─────────────────────────────────────────────────────────────
# Generate: openssl genrsa -out private.pem 2048
#           openssl rsa -in private.pem -pubout -out public.pem
#           base64 -w0 private.pem   (and public.pem)
JWT_PRIVATE_KEY=base64_encoded_rs256_private_key
JWT_PUBLIC_KEY=base64_encoded_rs256_public_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Razorpay (payments) ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# ─── Cloudinary (image storage) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# ─── MSG91 (SMS / OTP) ───────────────────────────────────────────────────────
# Leave blank in dev — OTPs are logged to the API console.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID_OTP=
MSG91_SENDER_ID=JEWELS

# ─── Resend (transactional email) ────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=dev@localhost.in
RESEND_FROM_NAME=Jewellery Dev

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ─── Typesense (search) ──────────────────────────────────────────────────────
# Leave blank in dev — search falls back to Postgres.
TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=

# ─── Shiprocket (logistics) ──────────────────────────────────────────────────
SHIPROCKET_EMAIL=dev@localhost.in
SHIPROCKET_PASSWORD=placeholder
SHIPROCKET_PICKUP_PINCODE=110001

# ─── Delhivery (logistics) ───────────────────────────────────────────────────
DELHIVERY_API_TOKEN=placeholder
DELHIVERY_CLIENT_NAME=DevBrand
DELHIVERY_PICKUP_PINCODE=110001

# ─── VAPID (web push) ────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@localhost.in

# ─── Sentry (error tracking) ─────────────────────────────────────────────────
SENTRY_DSN=

# ─── Supabase Storage (optional) ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── First SUPER_ADMIN bootstrap (one-time, production only) ─────────────────
# The application does not auto-create a Super Admin user.
# After running migrations in production for the first time, execute:
#   pnpm --filter @jewellery/api exec prisma db execute --stdin \
#     --schema=../../prisma/schema.prisma <<'SQL'
#   INSERT INTO "User" (id, name, email, "passwordHash", role, "isVerified", "createdAt", "updatedAt")
#   VALUES (gen_random_uuid(), 'Platform Admin', 'admin@yourdomain.in',
#           '<bcrypt-hash>', 'SUPER_ADMIN', true, now(), now());
#   SQL
# Generate the bcrypt hash with: node -e "require('bcrypt').hash('YourPass',12).then(console.log)"
# Do NOT commit these credentials anywhere. Do NOT set them as env vars.
