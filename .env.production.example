# ============================================================================
#  API environment — PRODUCTION template
#  Manage these as secrets in your platform (Render/Fly/Docker secrets/Vault).
#  Every value below MUST be a real production secret — no placeholders ship.
# ============================================================================

NODE_ENV=production
PORT=3001
API_URL=https://api.yourdomain.in
WEB_URL=https://yourdomain.in
# Only the real customer + admin origins. No localhost in production.
CORS_ORIGINS=https://yourdomain.in,https://admin.yourdomain.in

# ─── Database (managed Postgres, e.g. Neon) ──────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require           # pooled
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require             # unpooled (migrations)

# ─── Redis (required) ────────────────────────────────────────────────────────
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# ─── JWT (RS256) — required, unique per environment ──────────────────────────
JWT_PRIVATE_KEY=base64_encoded_rs256_private_key
JWT_PUBLIC_KEY=base64_encoded_rs256_public_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Razorpay (LIVE keys) ────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=__secret__
RAZORPAY_WEBHOOK_SECRET=__secret__

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=__set__
CLOUDINARY_API_KEY=__set__
CLOUDINARY_API_SECRET=__secret__

# ─── MSG91 (SMS / OTP) — required for real OTP delivery ──────────────────────
MSG91_AUTH_KEY=__secret__
MSG91_TEMPLATE_ID_OTP=__set__
MSG91_SENDER_ID=YOURCO

# ─── Resend (email) ──────────────────────────────────────────────────────────
RESEND_API_KEY=__secret__
RESEND_FROM_EMAIL=orders@yourdomain.in
RESEND_FROM_NAME=YourBrand Jewellery

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=__set__.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=__secret__
GOOGLE_CALLBACK_URL=https://api.yourdomain.in/api/v1/auth/google/callback

# ─── Typesense (required for search) ─────────────────────────────────────────
TYPESENSE_HOST=__host__
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=__secret__

# ─── Shiprocket ──────────────────────────────────────────────────────────────
SHIPROCKET_EMAIL=ops@yourdomain.in
SHIPROCKET_PASSWORD=__secret__
SHIPROCKET_PICKUP_PINCODE=110001

# ─── Delhivery ───────────────────────────────────────────────────────────────
DELHIVERY_API_TOKEN=__secret__
DELHIVERY_CLIENT_NAME=YourBrand
DELHIVERY_PICKUP_PINCODE=110001

# ─── VAPID (web push) ────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=__set__
VAPID_PRIVATE_KEY=__secret__
VAPID_SUBJECT=mailto:tech@yourdomain.in

# ─── Sentry (error tracking) ─────────────────────────────────────────────────
SENTRY_DSN=https://__key__@__org__.ingest.sentry.io/__project__

# ─── Supabase Storage (optional) ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin (set a strong unique password; rotate after first login) ──────────
ADMIN_EMAIL=admin@yourdomain.in
ADMIN_PASSWORD=__strong_secret__

# ─── Compose-only helpers (docker-compose.prod.yml) ──────────────────────────
REDIS_PASSWORD=__secret__
NEXT_PUBLIC_API_URL=https://api.yourdomain.in/api/v1
NEXT_PUBLIC_WEB_URL=https://yourdomain.in
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=__set__
