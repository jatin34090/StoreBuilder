# Delivery Agent App — environment variables
# Copy to .env and adjust. All EXPO_PUBLIC_* vars are inlined into the bundle.

# Base URL of the NestJS API (include /api/v1).
# For a physical device / emulator, use your machine's LAN IP, not localhost.
#   Android emulator: http://10.0.2.2:3001/api/v1
#   Physical device:  http://<your-lan-ip>:3001/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1

# EAS project id for Expo push notifications (from app.json > extra.eas.projectId).
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
