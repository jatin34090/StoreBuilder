// ─── Prisma schema — Multi-Tenant Jewellery SaaS Platform ───────────────────
// DB: PostgreSQL 16 on Neon
// ORM: Prisma 5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Plan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum StoreRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  DELIVERY_AGENT
}

enum StoreUserStatus {
  PENDING   // invitation sent, not yet accepted
  ACTIVE    // active member
  INACTIVE  // deactivated by owner
}

enum Role {
  CUSTOMER
  ADMIN
  DELIVERY_AGENT
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  COD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

enum DeliveryType {
  SELF
  THIRD_PARTY
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum CouponType {
  PERCENT
  FLAT
}

enum NotificationType {
  ORDER
  DELIVERY
  OFFER
  SYSTEM
  REVIEW
}

enum RemittanceStatus {
  PENDING
  SUBMITTED
  RECEIVED
}

enum SubscriptionStatus {
  CREATED
  AUTHENTICATED
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  VOID
}

enum StoreStatus {
  DRAFT
  SETUP
  ACTIVE
  SUSPENDED
  CLOSED
}

// ─── 1. Stores (Tenants) ─────────────────────────────────────────────────────

model Store {
  id           String      @id @default(uuid())
  name         String
  slug         String      @unique // subdomain: slug.platform.com
  customDomain String?     @unique // www.mystore.com
  plan         Plan        @default(FREE)
  status       StoreStatus @default(SETUP)
  isActive     Boolean     @default(true)
  logoUrl      String?
  faviconUrl   String?
  // Business details
  businessName String?
  industry     String?
  description  String?     @db.Text
  contactEmail String?
  phone        String?
  address      String?
  country      String      @default("IN")
  currency     String      @default("INR")
  timezone     String      @default("Asia/Kolkata")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  users          StoreUser[]
  categories     Category[]
  products       Product[]
  orders         Order[]
  coupons        Coupon[]
  notifications  Notification[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  deliveryAgents DeliveryAgent[]
  settings       StoreSetting[]
  quota          StoreQuotaUsage?
  apiLogs        TenantApiLog[]
  subscription   StoreSubscription?
  invoices       Invoice[]
  onboarding     OnboardingState?
  auditLogs      StoreAuditLog[]

  @@index([slug])
  @@index([customDomain])
  @@index([plan, isActive])
  @@index([status])
}

// Store membership — users can belong to many stores with different roles
model StoreUser {
  id                String          @id @default(uuid())
  storeId           String
  userId            String
  role              StoreRole       @default(STAFF)
  status            StoreUserStatus @default(ACTIVE)
  // Invitation fields — populated when member was invited by email
  invitationEmail   String?
  invitationToken   String?         @unique
  invitationExpires DateTime?
  invitedByUserId   String?
  invitedAt         DateTime?
  joinedAt          DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?  @relation("InvitedStaffMembers", fields: [invitedByUserId], references: [id])

  @@unique([storeId, userId])
  @@index([storeId, role])
  @@index([storeId, status])
  @@index([userId])
  @@index([invitationToken])
}

// Audit log for important staff actions within a store
model StoreAuditLog {
  id           String   @id @default(uuid())
  storeId      String
  actorUserId  String
  action       String   // e.g. INVITE_SENT, ROLE_CHANGED, MEMBER_REMOVED
  targetUserId String?
  metadata     Json?    // {oldRole, newRole, invitationEmail, etc.}
  createdAt    DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([actorUserId])
}

// Per-store settings (replaces global SiteSetting for tenant-owned config)
model StoreSetting {
  storeId   String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, key])
  @@index([storeId])
}

// ─── 2. Plan Limits (configurable by super-admin) ────────────────────────────

model PlanLimit {
  plan           Plan    @id
  maxProducts    Int     @default(100)
  maxStaff       Int     @default(3)
  maxStorageGB   Int     @default(5)
  maxApiPerDay   Int     @default(10000)
  maxApiPerMonth Int     @default(200000)
  maxOrders      Int?    // null = unlimited
  // Billing / display fields (editable by Super Admin)
  priceMonthly   Int     @default(0)   // in paise (₹0 = FREE)
  priceYearly    Int     @default(0)   // in paise
  currency       String  @default("INR")
  displayName    String  @default("")  // "Free", "Starter", etc.
  description    String?
  features       Json    @default("[]") // string[] of feature slugs
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)
  trialDays      Int     @default(0)   // 0 = no trial
  taxRatePct     Int     @default(18)  // GST % — Super Admin configurable
  updatedAt      DateTime @updatedAt
}

// ─── 3. Store Subscription (Razorpay SaaS billing) ───────────────────────────

model StoreSubscription {
  id                     String             @id @default(uuid())
  storeId                String             @unique
  razorpaySubId          String?            @unique  // sub_xxx (null for FREE / trial plans)
  razorpayCustomerId     String?                     // cust_xxx
  razorpayPlanId         String?                     // plan_xxx (null for FREE plan)
  plan                   Plan
  status                 SubscriptionStatus @default(CREATED)
  billingCycle           String             @default("MONTHLY") // "MONTHLY" | "YEARLY"
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialStart             DateTime?
  trialEnd               DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  cancelledAt            DateTime?
  chargeAt               DateTime?          // next billing date from Razorpay
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([razorpaySubId])
  @@index([storeId, status])
  @@index([status, trialEnd])  // for cron: find expiring trials
}

// ─── 4. Per-Tenant Quota Usage (counters updated in real-time) ───────────────

model StoreQuotaUsage {
  storeId        String   @id
  productCount   Int      @default(0)
  orderCount     Int      @default(0)
  customerCount  Int      @default(0)
  storageBytes   BigInt   @default(0)
  apiCallsToday  Int      @default(0)
  apiCallsMonth  Int      @default(0)
  lastDayReset   DateTime?
  lastMonthReset DateTime?
  updatedAt      DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// ─── 5. Invoices (immutable billing records) ─────────────────────────────────

model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique // INV-2026-000001
  storeId            String
  subscriptionId     String?
  plan               Plan
  planSnapshot       Json          @default("{}") // plan config at time of invoice
  amount             Int           @default(0)    // total in paise
  tax                Int           @default(0)    // tax in paise
  currency           String        @default("INR")
  status             InvoiceStatus @default(PENDING)
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  providerInvoiceId  String?       @unique
  issuedAt           DateTime      @default(now())
  paidAt             DateTime?

  store        Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subscription StoreSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([storeId, issuedAt])
  @@index([subscriptionId])
}

// ─── 6. Webhook Event (idempotency log) ──────────────────────────────────────

model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String   // "razorpay"
  eventId     String   // provider-supplied event/payment ID
  eventType   String   // "subscription.charged" etc.
  payload     Json     @default("{}")
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, processedAt])
}

// ─── 7. Billing Audit Log ────────────────────────────────────────────────────

model BillingAuditLog {
  id        String   @id @default(uuid())
  storeId   String?
  actorId   String?  // null = system/webhook
  action    String   // "plan.upgraded", "trial.started", "subscription.cancelled", …
  oldValue  Json?
  newValue  Json?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

// Tenant API request log (for billing / monitoring — rolling 30-day window)
model TenantApiLog {
  id        String   @id @default(uuid())
  storeId   String
  path      String
  method    String
  statusCode Int
  durationMs Int
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

// Per-store onboarding progress tracker
model OnboardingState {
  storeId      String    @id
  businessInfo Boolean   @default(false)
  storeUrl     Boolean   @default(false)
  theme        Boolean   @default(false)
  firstProduct Boolean   @default(false)
  payment      Boolean   @default(false)
  shipping     Boolean   @default(false)
  launched     Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// Platform-level settings (super-admin only)
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── 4. Users & Auth (platform-level) ────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  name          String
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String?
  role                     Role      @default(CUSTOMER)
  isVerified               Boolean   @default(false)
  isBlocked                Boolean   @default(false)
  avatar                   String?
  dob                      DateTime?
  expoPushToken            String?
  emailVerifiedAt          DateTime?
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  wishlist      WishlistItem[]
  reviews       Review[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  deliveryAgent        DeliveryAgent?
  storeUsers           StoreUser[]
  invitedStaffMembers  StoreUser[] @relation("InvitedStaffMembers")

  @@index([email, phone])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id        String  @id @default(uuid())
  userId    String
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// ─── 5. Catalogue (tenant-scoped) ────────────────────────────────────────────

model Category {
  id        String  @id @default(uuid())
  storeId   String
  name      String
  slug      String  // unique per store (@@unique below)
  image     String?
  parentId  String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("tree", fields: [parentId], references: [id])
  children Category[] @relation("tree")
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId, isActive])
  @@index([storeId, parentId])
  @@index([storeId, sortOrder])
}

model Product {
  id          String   @id @default(uuid())
  storeId     String
  name        String
  slug        String   // unique per store (@@unique below)
  description String   @db.Text
  categoryId  String
  basePrice   Decimal  @db.Decimal(10, 2)
  discountPct Int      @default(0)
  attributes  Json
  tags        String[]
  metaTitle   String?
  metaDesc    String?
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store    Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id])
  images   ProductImage[]
  variants ProductVariant[]
  reviews  Review[]
  wishlist WishlistItem[]

  @@unique([storeId, slug])
  @@index([storeId, isActive, createdAt])
  @@index([storeId, categoryId, isActive])
  @@index([storeId, isFeatured, isActive])
  @@index([storeId, createdAt])
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  sku       String  @unique
  size      String?
  color     String?
  price     Decimal @db.Decimal(10, 2)
  stock     Int     @default(0)
  weight    Float

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images     ProductImage[]
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([sku])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  variantId String?
  publicId  String
  url       String
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, isPrimary])
  @@index([variantId])
}

// ─── 6. Cart (tenant-scoped) ─────────────────────────────────────────────────

model CartItem {
  id        String   @id @default(uuid())
  storeId   String
  userId    String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId, variantId])
  @@index([storeId, userId])
}

// ─── 7. Wishlist (tenant-scoped) ─────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(uuid())
  storeId   String
  userId    String
  productId String
  createdAt DateTime @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId, productId])
  @@index([storeId, userId])
}

// ─── 8. Orders (tenant-scoped) ───────────────────────────────────────────────

model Order {
  id             String      @id @default(uuid())
  storeId        String
  orderNumber    String      @unique @default(cuid())
  userId         String
  addressId      String
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(10, 2)
  discountAmount Decimal     @db.Decimal(10, 2) @default(0)
  shippingCharge Decimal     @db.Decimal(10, 2) @default(0)
  total          Decimal     @db.Decimal(10, 2)
  couponId       String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  store          Store              @relation(fields: [storeId], references: [id])
  user           User               @relation(fields: [userId], references: [id])
  address        Address            @relation(fields: [addressId], references: [id])
  coupon         Coupon?            @relation(fields: [couponId], references: [id])
  items          OrderItem[]
  payment        Payment?
  delivery       Delivery?
  remittanceItem CodRemittanceItem?

  @@index([storeId, status, createdAt])
  @@index([storeId, userId, createdAt])
  @@index([storeId, createdAt])
  @@index([storeId, status])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  variantId String
  name      String
  sku       String
  price     Decimal @db.Decimal(10, 2)
  quantity  Int
  image     String

  order   Order          @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

// ─── 9. Payments ─────────────────────────────────────────────────────────────

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @unique
  method          PaymentMethod
  gateway         String
  razorpayOrderId String?       @unique
  razorpayPayId   String?       @unique
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  refundId        String?
  refundAmount    Decimal?      @db.Decimal(10, 2)
  refundedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([razorpayOrderId, razorpayPayId])
}

// ─── 10. Delivery (tenant-scoped agents) ─────────────────────────────────────

model DeliveryAgent {
  id          String   @id @default(uuid())
  storeId     String
  userId      String   @unique
  vehicleType String
  zones       String[]
  isOnline    Boolean  @default(false)
  currentLat  Float?
  currentLng  Float?
  rating      Float    @default(5.0)

  store       Store           @relation(fields: [storeId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
  deliveries  Delivery[]
  remittances CodRemittance[]

  @@index([storeId, isOnline])
}

model Delivery {
  id            String         @id @default(uuid())
  orderId       String         @unique
  type          DeliveryType
  agentId       String?
  provider      String?
  awbCode       String?
  trackingUrl   String?
  otpHash       String?
  otpVerified   Boolean        @default(false)
  status        DeliveryStatus @default(PENDING)
  estimatedAt   DateTime?
  deliveredAt   DateTime?
  failureReason String?
  locationLog   Json[]
  codCollected  Boolean        @default(false)
  codCollectedAt DateTime?

  order Order          @relation(fields: [orderId], references: [id])
  agent DeliveryAgent? @relation(fields: [agentId], references: [id])
}

model CodRemittance {
  id          String           @id @default(uuid())
  agentId     String
  status      RemittanceStatus @default(PENDING)
  totalAmount Decimal          @db.Decimal(10, 2)
  notes       String?
  submittedAt DateTime?
  receivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  agent DeliveryAgent       @relation(fields: [agentId], references: [id])
  items CodRemittanceItem[]

  @@index([agentId, status])
}

model CodRemittanceItem {
  id           String   @id @default(uuid())
  remittanceId String
  orderId      String   @unique
  amount       Decimal  @db.Decimal(10, 2)
  collectedAt  DateTime @default(now())

  remittance CodRemittance @relation(fields: [remittanceId], references: [id], onDelete: Cascade)
  order      Order         @relation(fields: [orderId], references: [id])
}

// ─── 11. Marketing (tenant-scoped) ───────────────────────────────────────────

model Coupon {
  id             String     @id @default(uuid())
  storeId        String
  code           String     @db.VarChar(32) // unique per store (@@unique below)
  type           CouponType
  value          Decimal    @db.Decimal(10, 2)
  minOrderAmount Decimal?   @db.Decimal(10, 2)
  maxDiscount    Decimal?   @db.Decimal(10, 2)
  usageLimit     Int?
  usedCount      Int        @default(0)
  expiresAt      DateTime?
  isActive       Boolean    @default(true)

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, code])
  @@index([storeId, isActive])
}

// ─── 12. Reviews & Notifications (tenant-scoped) ─────────────────────────────

model Review {
  id        String   @id @default(uuid())
  storeId   String
  productId String
  userId    String
  orderId   String
  rating    Int
  title     String?
  body      String?  @db.Text
  images    String[]
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([userId, orderId, productId])
  @@index([storeId, productId, isVisible])
  @@index([storeId, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  storeId   String
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([storeId, userId, isRead])
  @@index([storeId, createdAt])
}
